# Local defaults. No credentials are needed for demo mode.
HOST=127.0.0.1
WEB_PORT=3000
API_PORT=8080
INVENTORY_PORT=8001
PRICING_PORT=8002
CRM_PORT=8003
LIONETTA_AGENT_MODE=demo

# Claude: copy this file to .env, fill the key there, and restart npm run dev.
# The app/MCP services stay local; reasoning uses Anthropic's hosted API.
# LIONETTA_AGENT_MODE=anthropic
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Alternative OpenAI mode (never commit your actual key):
# LIONETTA_AGENT_MODE=openai
# LIONETTA_MODEL_API_KEY=
# LIONETTA_MODEL=gpt-4.1-mini
# LIONETTA_MODEL_BASE_URL=https://api.openai.com/v1

# Optional overrides for the local MCP endpoints:
# LIONETTA_INVENTORY_URL=http://127.0.0.1:8001/mcp
# LIONETTA_PRICING_URL=http://127.0.0.1:8002/mcp
# LIONETTA_CRM_URL=http://127.0.0.1:8003/mcp
